# Copy to .env for local overrides. Never commit real values.

# --- Backend ---------------------------------------------------------------
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://eximion:eximion@127.0.0.1:5433/eximion
TEST_DATABASE_URL=postgresql+psycopg://eximion:eximion@127.0.0.1:5433/eximion_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_CONNECT_TIMEOUT_SECONDS=5
# Required in production; protects POST /api/v1/cases (case authoring).
ADMIN_API_KEY=local-dev-admin-key
LOG_LEVEL=INFO

# --- Frontend (server-side only, never exposed to the browser) -------------
API_BASE_URL=http://localhost:8000

# --- LLM pipeline -----------------------------------------------------------
# Vertex AI (preferred): uses Application Default Credentials, no key in env.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Alternative: Gemini Developer API key (used only when GOOGLE_CLOUD_PROJECT is empty).
GEMINI_API_KEY=
# Optional: Jev (TypeSafe) as the verifier for extracted cases.
# Needed only for `extract --verify typesafe` and `eval-decisions --provider typesafe`.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
